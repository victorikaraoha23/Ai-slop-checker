# Optional: enables the AI second-opinion critic via OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model used for the second opinion
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: Microlink API key (screenshot API works without one at low volume)
MICROLINK_API_KEY=
