# Optional AI capability: enables the second-opinion critic via OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model used for the second opinion
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Used by the preview redirect flow when Supabase auth is enabled.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
