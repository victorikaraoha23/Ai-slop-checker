{
  "name": "ai-slop-checker",
  "version": "1.0.0",
  "private": true,
  "description": "A field instrument for machine-made websites — paste a link or drop a screenshot, get a slop verdict.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx tests/smoke.ts && npx tsx tests/api.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "mammoth": "^1.13.0",
    "next": "^14.2.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
